.product-card {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 24rpx rgba(24, 52, 43, 0.05);
}
.visual {
  height: 220rpx;
  display: grid;
  place-items: center;
  background: #ece8d8;
  position: relative;
}
.visual.orange {
  background: #f3d8c9;
}
.visual.green {
  background: #d9e4d8;
}
.visual .emoji {
  font-size: 110rpx;
  line-height: 1;
}
.visual .tag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  background: var(--orange);
  color: #fff;
  border-radius: 10rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
}
/* 批发标识：全站商品均为批发直供，单笔满 ¥1000 起订 */
.visual .ws-tag {
  position: absolute;
  right: 16rpx;
  top: 16rpx;
  background: var(--green);
  color: #fff;
  border-radius: 10rpx;
  padding: 2rpx 12rpx;
  font-size: 20rpx;
}
.pbody {
  padding: 18rpx 20rpx 22rpx;
}
.pname {
  font-size: 27rpx;
  font-weight: 700;
  line-height: 1.4;
}
.pspec {
  margin-top: 4rpx;
  color: var(--muted);
  font-size: 22rpx;
}
.price-row {
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.price {
  color: var(--orange);
  font-weight: 800;
  display: flex;
  align-items: baseline;
}
.price .sym {
  font-size: 22rpx;
}
.price .num {
  font-size: 34rpx;
}
.price .origin {
  margin-left: 10rpx;
  color: #b3ada0;
  font-size: 20rpx;
  font-weight: 400;
  text-decoration: line-through;
}
/* 用 view 代替 button：避免 button 内置样式在不同基础库下的渲染差异 */
.add {
  flex: none;
  width: 54rpx;
  height: 54rpx;
  border-radius: 50%;
  background: var(--green);
  color: #fff;
  font-size: 34rpx;
  display: grid;
  place-items: center;
  line-height: 1;
}
