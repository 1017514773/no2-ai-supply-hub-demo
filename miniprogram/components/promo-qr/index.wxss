.qr-wrap {
  position: relative;
  display: inline-block;
  padding: 20rpx;
  background: #fff;
  border: 1rpx solid var(--line);
  border-radius: 20rpx;
}
.qr-grid {
  display: flex;
  flex-wrap: wrap;
}
.cell {
  background: #fff;
}
.cell.on {
  background: #17372c;
}
.qr-logo {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background: var(--green);
  color: var(--lime);
  display: grid;
  place-items: center;
  font-size: 28rpx;
  font-weight: 900;
  border: 6rpx solid #fff;
}
