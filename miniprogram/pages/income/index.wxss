/* 底部留白 ≥ 自定义导航栏高度（112rpx + 安全区），避免内容被遮挡 */
.page {
  padding: 20rpx 28rpx 180rpx;
}

/* 顶部大数字 */
.hero {
  background: linear-gradient(135deg, #155c45, #1d7357);
  color: #fff;
  border: none;
  padding: 34rpx 30rpx;
}
.hero-label {
  font-size: 24rpx;
  opacity: 0.85;
}
.hero-num {
  font-size: 76rpx;
  font-weight: 900;
  line-height: 1.25;
  letter-spacing: 2rpx;
}
.hero-sub {
  font-size: 22rpx;
  opacity: 0.8;
  margin-bottom: 24rpx;
}

/* 数据格 */
.cell {
  text-align: center;
  padding: 16rpx 0;
}
.cell-num {
  font-size: 30rpx;
  font-weight: 900;
}
.cell-num.ok {
  color: var(--green);
}
.cell-label {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 6rpx;
}

/* 柱状图 */
.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  padding-top: 10rpx;
}
.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.bar-num {
  font-size: 19rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}
.bar-track {
  width: 100%;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  background: #f1ecdf;
  border-radius: 10rpx;
  overflow: hidden;
}
.bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #1d7357, #155c45);
}
.bar-label {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* 流水 */
.link {
  color: var(--green);
  font-weight: 700;
  font-size: 24rpx;
}
.cm {
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}
.cm:last-of-type {
  margin-bottom: 4rpx;
}
.cm-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}
.cm-type {
  font-size: 25rpx;
  font-weight: 700;
}
.cm-amount {
  font-size: 27rpx;
  font-weight: 800;
  color: var(--green);
  flex-shrink: 0;
}
.cm-amount.neg {
  color: var(--orange);
}
.cm-meta {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.cm-explain {
  font-size: 23rpx;
  color: #4a4a44;
  background: #f4f0e4;
  border-radius: 12rpx;
  padding: 14rpx 16rpx;
  margin-top: 12rpx;
  line-height: 1.55;
}
