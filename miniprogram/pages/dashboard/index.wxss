.page {
  padding: 20rpx 28rpx 80rpx;
}

/* 汇总 hero */
.hero {
  background: linear-gradient(135deg, #155c45, #1d7357);
  color: #fff;
  border: none;
}
.hero-label {
  font-size: 22rpx;
  opacity: 0.85;
}
.hero-num {
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1.3;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.95;
}
.hero-meta {
  font-size: 21rpx;
  opacity: 0.75;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

/* tabs 胶囊 */
.tabs {
  white-space: nowrap;
  margin-bottom: 22rpx;
}
.tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  font-size: 25rpx;
  color: var(--muted);
}
.tab.on {
  background: var(--green);
  color: #fff;
  border-color: var(--green);
  font-weight: 700;
}

/* 指标格 */
.m-item {
  background: #f7f4ea;
  border-radius: 16rpx;
  padding: 18rpx 16rpx;
}
.m-num {
  font-size: 30rpx;
  font-weight: 900;
}
.m-label {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* 柱状图 */
.bars {
  display: flex;
  align-items: flex-end;
  gap: 12rpx;
  height: 300rpx;
  padding-top: 16rpx;
}
.bar-col {
  flex: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}
.bar-val {
  font-size: 18rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
  white-space: nowrap;
}
.bar-fill {
  width: 100%;
  border-radius: 10rpx 10rpx 4rpx 4rpx;
  background: #cfd8c6;
  min-height: 10rpx;
}
.bar-fill.today {
  background: var(--green);
}
.bar-label {
  font-size: 20rpx;
  color: var(--muted);
  margin-top: 10rpx;
}
