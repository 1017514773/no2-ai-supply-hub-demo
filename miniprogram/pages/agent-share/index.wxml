<view class="page">
  <view class="card qr-card">
    <view class="qr-title">我的推广码</view>
    <promo-qr seed="{{qrSeed}}" boxRpx="360" />
    <view class="code-row" bindtap="onCopy" aria-label="复制推广码">
      <text class="code-no">{{user ? user.agentNo : '--'}}</text>
      <text class="copy-tag">复制</text>
    </view>
    <view class="qr-name">{{user ? user.nickname : ''}} · {{area}}推广伙伴</view>
  </view>

  <view class="card">
    <view class="card-title">分享给好友</view>
    <view class="muted">转发小程序卡片给微信好友/社群，好友下单成功后您可获得推广奖励费（具体金额按订单实付计算）。</view>
    <button class="cta mt18" open-type="share" aria-label="分享给好友">转发给好友 / 社群</button>
    <button class="cta ghost mt18" bindtap="onScanVerify" aria-label="客户扫码验证">客户扫码验证</button>
  </view>

  <view class="card">
    <view class="card-title">
      客户归属记录
      <text class="muted">生效 {{activeCount}} 人</text>
    </view>
    <view class="rf" wx:for="{{referrals}}" wx:key="id">
      <view class="rf-head">
        <view class="rf-left">
          <text class="rf-name">{{item.customerName}}</text>
          <text class="pill {{item.pill}}">{{item.statusLabel}}</text>
        </view>
        <text class="muted">{{item.boundText}}</text>
      </view>
      <view class="rf-meta">编号 {{item.customerNo}} · 来源 {{item.source}} · 归属 {{item.ownerName}}（{{item.ownerAgentNo}}）</view>
      <view class="rf-note" wx:if="{{item.correctedFrom}}">纠错留痕：原归属 {{item.correctedFrom}} → 现归属 {{item.ownerAgentNo}}</view>
      <view class="rf-note warn" wx:if="{{item.revokeReason}}">已撤销：{{item.revokeReason}}（{{item.revokedBy}}）</view>
      <view class="rf-ops" wx:if="{{item.isActive}}">
        <button class="cta small ghost" data-id="{{item.id}}" bindtap="onRevoke" aria-label="撤销归属">撤销归属</button>
        <button wx:if="{{!item.isMine}}" class="cta small" data-id="{{item.id}}" bindtap="onCorrect" aria-label="纠错归属">纠错归属</button>
      </view>
    </view>
    <view wx:if="{{!referrals.length}}" class="muted">暂无归属记录</view>
    <view class="muted">{{referralNote}}</view>
    <view class="muted">后台操作：撤销 / 纠错均写入审计日志（可在分销资格页查看），历史关系记录完整保留。</view>
  </view>

  <view class="card">
    <view class="card-title">推广归属规则</view>
    <view class="rule">· 客户通过推广码/分享首次下单后绑定归属，按推广奖励费规则计发；</view>
    <view class="rule">· 归属变更需人工审批并保留原关系记录（可在资格页审计日志查看）；</view>
    <view class="rule">· 退款订单不计流水与佣金，已记录佣金生成负向冲销流水；</view>
  </view>

  <view class="disclaimer">佣金试算仅供参考，不构成收益承诺；正式链接与二维码以后端生成为准。</view>
</view>
