/* 底部留白 ≥ 自定义导航栏高度（112rpx + 安全区），避免内容被遮挡 */
.page {
  padding: 20rpx 28rpx 180rpx;
}

/* 用户卡 */
.me-card {
  background: linear-gradient(135deg, #155c45, #1d7357);
  color: #fff;
  border: none;
}
.me-top {
  display: flex;
  align-items: center;
  gap: 24rpx;
}
.me-avatar {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  background: var(--lime);
  color: var(--green);
  font-size: 48rpx;
  font-weight: 900;
  display: grid;
  place-items: center;
}
.me-name {
  font-size: 38rpx;
  font-weight: 800;
}
.me-meta {
  font-size: 23rpx;
  opacity: 0.9;
  margin-top: 6rpx;
}
.me-sub {
  font-size: 22rpx;
  opacity: 0.8;
  margin-top: 8rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.realname {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 999rpx;
  padding: 2rpx 14rpx;
}

/* 订单快捷 */
.link {
  color: var(--green);
  font-weight: 700;
  font-size: 24rpx;
}
.o-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
.o-entry {
  text-align: center;
  padding: 10rpx 0;
}
.o-icon {
  font-size: 44rpx;
  color: var(--green);
  line-height: 1.3;
}
.o-label {
  font-size: 23rpx;
  margin-top: 8rpx;
}

/* 工具宫格 */
.t-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}
.t-item {
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 22rpx 6rpx;
  text-align: center;
  background: #fbf8ef;
}
.t-icon {
  font-size: 38rpx;
  color: var(--green);
  line-height: 1.2;
}
.t-label {
  font-size: 21rpx;
  margin-top: 10rpx;
}

.mt18 {
  margin-top: 18rpx;
}
