.page {
  padding: 20rpx 28rpx 80rpx;
}

.head-row {
  display: flex;
  align-items: center;
  gap: 18rpx;
}
.ai-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: var(--lime);
  color: var(--green);
  font-size: 40rpx;
  font-weight: 900;
  display: grid;
  place-items: center;
}
.head-info {
  flex: 1;
}
.head-title {
  font-size: 30rpx;
  font-weight: 800;
}
.clear {
  color: var(--muted);
  font-size: 24rpx;
}

/* 对话 */
.chat {
  margin-bottom: 24rpx;
}
.msg {
  display: flex;
  margin-bottom: 18rpx;
}
.msg.user {
  justify-content: flex-end;
}
.bubble {
  max-width: 84%;
  border-radius: 22rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.65;
}
.msg.ai .bubble {
  background: var(--card);
  border: 1rpx solid var(--line);
  border-top-left-radius: 6rpx;
}
.msg.user .bubble {
  background: var(--green);
  color: #fff;
  border-top-right-radius: 6rpx;
}

/* 问题 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 22rpx;
}
.chip {
  border: 1rpx solid var(--green);
  color: var(--green);
  border-radius: 999rpx;
  padding: 12rpx 26rpx;
  font-size: 23rpx;
  background: #eef5ef;
}

/* 输入行 */
.input-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 999rpx;
  padding: 14rpx 14rpx 14rpx 28rpx;
  background: #fbf8ef;
}
.input-ph {
  flex: 1;
  color: #b3b0a6;
  font-size: 25rpx;
}
.send {
  background: var(--green);
  color: #fff;
  border-radius: 999rpx;
  padding: 12rpx 36rpx;
  font-size: 25rpx;
  font-weight: 700;
}
