/* 底部留白 ≥ 自定义导航栏高度（112rpx + 安全区），避免内容被遮挡 */
.page {
  padding: 20rpx 28rpx 180rpx;
}

/* 用户卡 */
.me-card {
  background: linear-gradient(135deg, #155c45, #1d7357);
  color: #fff;
  border: none;
}
.me-top {
  display: flex;
  align-items: center;
  gap: 22rpx;
}
.me-avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 50%;
  background: var(--lime);
  color: var(--green);
  font-size: 44rpx;
  font-weight: 900;
  display: grid;
  place-items: center;
}
.me-name {
  font-size: 36rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.me-meta {
  font-size: 23rpx;
  opacity: 0.88;
  margin-top: 8rpx;
}
.qual-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
  font-size: 25rpx;
  font-weight: 700;
}
.chev {
  opacity: 0.9;
  font-weight: 400;
}
.frozen-line {
  margin-top: 14rpx;
  padding: 14rpx 18rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  font-size: 23rpx;
  line-height: 1.5;
}
.checks {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}
.check {
  font-size: 22rpx;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.16);
  opacity: 0.75;
}
.check.on {
  background: var(--lime);
  color: var(--green);
  font-weight: 700;
  opacity: 1;
}

/* 柱状图 */
.chart {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 12rpx;
  padding-top: 10rpx;
}
.bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.bar-num {
  font-size: 19rpx;
  color: var(--muted);
  margin-bottom: 6rpx;
}
.bar-track {
  width: 100%;
  height: 160rpx;
  display: flex;
  align-items: flex-end;
  background: #f1ecdf;
  border-radius: 10rpx;
  overflow: hidden;
}
.bar-fill {
  width: 100%;
  background: linear-gradient(180deg, #1d7357, #155c45);
  border-radius: 10rpx 10rpx 0 0;
}
.bar-label {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 8rpx;
}

/* 数据格 */
.cell {
  text-align: center;
  padding: 14rpx 0;
}
.cell-num {
  font-size: 32rpx;
  font-weight: 900;
}
.cell-num.ok {
  color: var(--green);
}
.cell-label {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.mt14 {
  margin-top: 14rpx;
}
.mini-links {
  display: flex;
  gap: 22rpx;
}
.link {
  color: var(--green);
  font-weight: 700;
  font-size: 24rpx;
}

/* 工具宫格 */
.tools {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18rpx;
}
.tool {
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 22rpx 0;
  text-align: center;
  background: #fbf8ef;
}
.tool-icon {
  font-size: 40rpx;
  color: var(--green);
  line-height: 1.2;
}
.tool-name {
  font-size: 22rpx;
  margin-top: 10rpx;
}

/* 费率 */
.rate-row {
  padding: 16rpx 0;
  border-bottom: 1rpx dashed var(--line);
  font-size: 26rpx;
}
.rate-row:last-of-type {
  border-bottom: none;
}
.rate {
  color: var(--orange);
  font-weight: 800;
}
