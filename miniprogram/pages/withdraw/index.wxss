.page {
  padding: 20rpx 28rpx 80rpx;
}

/* 拦截卡 */
.block-card {
  background: #fdf3ec;
  border: 2rpx dashed var(--orange);
  border-radius: 20rpx;
  padding: 26rpx;
  margin-bottom: 24rpx;
}
.b-title {
  font-size: 29rpx;
  font-weight: 800;
  color: var(--orange);
}
.b-status {
  font-size: 24rpx;
  color: var(--muted);
  margin: 10rpx 0;
}
.b-item {
  font-size: 24rpx;
  color: #4a4a44;
  line-height: 1.8;
}
.block-card .cta {
  margin-top: 18rpx;
}

/* 金额 */
.wd-num-label {
  font-size: 24rpx;
  color: var(--muted);
}
.wd-num {
  font-size: 72rpx;
  font-weight: 900;
  color: var(--green);
  line-height: 1.3;
  margin-bottom: 6rpx;
}

/* 表单 */
.field {
  display: flex;
  align-items: center;
  gap: 16rpx;
  border-bottom: 1rpx solid var(--line);
  padding: 22rpx 4rpx;
}
.f-label {
  width: 160rpx;
  color: var(--muted);
  font-size: 25rpx;
  flex-shrink: 0;
}
.f-input {
  flex: 1;
  font-size: 30rpx;
  font-weight: 700;
}
.f-static {
  flex: 1;
  font-size: 26rpx;
}
.all {
  color: var(--green);
  font-weight: 700;
  font-size: 24rpx;
}
.mt18 {
  margin-top: 18rpx;
}
.mt14 {
  margin-top: 14rpx;
}

/* 记录 */
.rec {
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  padding: 20rpx 22rpx;
  margin-bottom: 16rpx;
}
.rec:last-of-type {
  margin-bottom: 4rpx;
}
.rec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.rec-amount {
  font-size: 30rpx;
  font-weight: 900;
}
.rec-meta {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
