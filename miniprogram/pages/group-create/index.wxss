.page {
  padding: 20rpx 28rpx 80rpx;
}

/* 资格提示 */
.warn-card {
  background: #fdf3ec;
  border: 2rpx dashed var(--orange);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.w-title {
  font-weight: 800;
  color: var(--orange);
  font-size: 27rpx;
}
.w-desc {
  font-size: 23rpx;
  color: var(--muted);
  margin: 10rpx 0 18rpx;
  line-height: 1.6;
}

/* 商品选择 */
.p-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 18rpx;
}
.p-item {
  position: relative;
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 18rpx;
}
.p-item.on {
  border-color: var(--green);
  background: #eef5ef;
}
.p-emoji {
  width: 104rpx;
  height: 104rpx;
  border-radius: 16rpx;
  display: grid;
  place-items: center;
  margin-bottom: 12rpx;
}
.p-emoji .emoji {
  font-size: 52rpx;
}
.p-name {
  font-size: 24rpx;
  font-weight: 700;
  min-height: 66rpx;
}
.p-price {
  color: var(--orange);
  font-weight: 800;
  font-size: 26rpx;
  margin-top: 6rpx;
}
.p-check {
  position: absolute;
  top: 10rpx;
  right: 14rpx;
  color: var(--green);
  font-weight: 900;
  font-size: 30rpx;
}

/* chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  padding: 14rpx 34rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  font-size: 25rpx;
  color: var(--muted);
}
.chip.on {
  background: var(--green);
  border-color: var(--green);
  color: #fff;
  font-weight: 700;
}
.mt {
  margin-top: 30rpx;
}

/* 备注框：行高与内容区（88rpx 高 - 上下 1rpx 边框）等高，聚焦时文字不跳动 */
.note {
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  padding: 0 20rpx;
  height: 88rpx;
  line-height: 86rpx;
  font-size: 26rpx;
  background: #fbf8ef;
}
.rule {
  font-size: 25rpx;
  line-height: 1.8;
}
