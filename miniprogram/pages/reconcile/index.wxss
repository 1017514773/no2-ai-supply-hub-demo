.page {
  padding: 20rpx 28rpx 80rpx;
}

/* 汇总 hero */
.hero {
  background: linear-gradient(135deg, #155c45, #1d7357);
  color: #fff;
  border: none;
}
.hero-label {
  font-size: 22rpx;
  opacity: 0.85;
}
.hero-num {
  font-size: 64rpx;
  font-weight: 900;
  line-height: 1.3;
}
.hero-sub {
  font-size: 24rpx;
  opacity: 0.95;
}
.hero-meta {
  font-size: 21rpx;
  opacity: 0.75;
  margin-top: 16rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}

/* tabs 胶囊 */
.tabs {
  white-space: nowrap;
  margin-bottom: 22rpx;
}
.tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  font-size: 25rpx;
  color: var(--muted);
}
.tab.on {
  background: var(--green);
  color: #fff;
  border-color: var(--green);
  font-weight: 700;
}

/* 指标格 */
.m-item {
  background: #f7f4ea;
  border-radius: 16rpx;
  padding: 18rpx 16rpx;
}
.m-num {
  font-size: 30rpx;
  font-weight: 900;
}
.m-label {
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 4rpx;
}

/* 明细行 */
.tr {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.tr:last-of-type {
  border-bottom: none;
}
.tr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tr-type {
  font-size: 27rpx;
  font-weight: 800;
}
.tr-amount {
  font-size: 28rpx;
  font-weight: 900;
  color: var(--green);
}
.tr-amount.neg {
  color: var(--orange);
}
.tr-meta {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.tr-note {
  font-size: 23rpx;
  color: #4a4a44;
  margin-top: 6rpx;
}
.mt18 {
  margin-top: 18rpx;
}
