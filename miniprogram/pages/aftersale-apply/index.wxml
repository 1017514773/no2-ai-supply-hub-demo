<wxs src="../../utils/format.wxs" module="fmt" />
<view class="page">
  <block wx:if="{{order}}">
    <view class="card">
      <view class="card-title">售后订单</view>
      <view class="row"><text class="label">订单号</text><text>{{order.orderNo}}</text></view>
      <view class="row"><text class="label">下单时间</text><text>{{order.createdText}}</text></view>
      <view class="row"><text class="label">履约方式</text><text>{{order.fulfillmentLabel}}</text></view>
      <view class="row"><text class="label">商品件数</text><text>{{order.itemCount}} 件</text></view>
      <view class="row"><text class="label">实付金额</text><text class="amount">¥{{fmt.yuan(order.payableFen)}}</text></view>
    </view>

    <view class="card">
      <view class="card-title">售后原因（必选）</view>
      <view
        wx:for="{{reasons}}"
        wx:key="*this"
        class="reason {{reason === item ? 'on' : ''}}"
        data-reason="{{item}}"
        bindtap="onReason"
        aria-label="选择原因 {{item}}"
      >
        <view class="radio">{{reason === item ? '●' : '○'}}</view>
        <text>{{item}}</text>
      </view>
    </view>

    <view class="card">
      <view class="card-title">退款金额（元）</view>
      <view class="amount-row">
        <text class="sym">¥</text>
        <input
          class="amount-input"
          type="digit"
          value="{{amountYuan}}"
          bindinput="onAmount"
          aria-label="退款金额"
        />
      </view>
      <view class="muted">最多可退实付金额 ¥{{maxYuan}}（支持全额或部分退款）。</view>
    </view>

    <view class="card">
      <view class="card-title">问题描述（选填）</view>
      <textarea
        class="remark"
        value="{{remark}}"
        maxlength="120"
        placeholder="补充说明问题，便于客服审核"
        bindinput="onRemark"
        aria-label="问题描述"
      />
    </view>

    <view class="card notice">
      <view class="card-title">提交前须知</view>
      <view class="notice-item">· 提交后订单进入「售后中」，期间不计入业绩；</view>
      <view class="notice-item">· 审核通过后按原路退款，并自动生成负向冲销佣金流水（保留历史账）；</view>
      <view class="notice-item">· 审核驳回后订单恢复原状态，重新计入业绩；</view>
    </view>

    <view class="disclaimer">退款金额以审核结果为准。</view>

    <view class="footer-bar">
      <button class="cta {{submitting ? 'disabled' : ''}}" bindtap="onSubmit" aria-label="提交售后申请">
        {{submitting ? '提交中…' : '提交售后申请'}}
      </button>
    </view>
  </block>
</view>
