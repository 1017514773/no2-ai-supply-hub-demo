.page {
  padding: 20rpx 28rpx 80rpx;
}

.amount {
  color: var(--orange);
  font-weight: 800;
}

/* 原因单选 */
.reason {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 22rpx 18rpx;
  border: 1rpx solid var(--line);
  border-radius: 16rpx;
  margin-bottom: 14rpx;
  font-size: 26rpx;
}
.reason.on {
  border-color: var(--green);
  background: #eef5ef;
  font-weight: 700;
}
.radio {
  color: var(--green);
  font-size: 26rpx;
}

/* 金额输入 */
.amount-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  border-bottom: 2rpx solid var(--green);
  padding: 12rpx 4rpx;
  margin: 8rpx 0 16rpx;
}
.sym {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--green);
}
.amount-input {
  flex: 1;
  font-size: 38rpx;
  font-weight: 800;
}

/* 备注 */
.remark {
  width: 100%;
  box-sizing: border-box;
  min-height: 140rpx;
  font-size: 26rpx;
  line-height: 1.6;
  padding: 16rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  background: #fbf8ef;
}

/* 须知 */
.notice-item {
  font-size: 24rpx;
  color: #4a4a44;
  line-height: 1.75;
}
