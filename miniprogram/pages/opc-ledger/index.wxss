.page {
  padding: 20rpx 28rpx 80rpx;
}

/* 汇总 */
.hero {
  background: linear-gradient(135deg, #155c45, #1d7357);
  color: #fff;
  border: none;
}
.hero-subject {
  font-size: 24rpx;
  opacity: 0.9;
  line-height: 1.5;
}
.hero-num {
  font-size: 68rpx;
  font-weight: 900;
  line-height: 1.3;
}
.hero-label {
  font-size: 22rpx;
  opacity: 0.8;
}
.hero-row {
  display: flex;
  gap: 60rpx;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 1rpx solid rgba(255, 255, 255, 0.25);
}
.hr-num {
  font-size: 30rpx;
  font-weight: 800;
}
.hr-label {
  font-size: 21rpx;
  opacity: 0.8;
  margin-top: 4rpx;
}

/* 明细 */
.tr {
  padding: 20rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.tr:last-of-type {
  border-bottom: none;
}
.tr-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tr-type {
  font-size: 27rpx;
  font-weight: 800;
}
.tr-amount {
  font-size: 29rpx;
  font-weight: 900;
}
.tr-amount.pos {
  color: var(--green);
}
.tr-amount.neg {
  color: var(--orange);
}
.tr-meta {
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.tr-note {
  font-size: 24rpx;
  color: #4a4a44;
  margin-top: 8rpx;
}
.mt18 {
  margin-top: 18rpx;
}
