.page {
  padding: 20rpx 28rpx 80rpx;
}

.head-title {
  font-size: 36rpx;
  font-weight: 900;
}
.head-sub {
  font-size: 25rpx;
  color: var(--green);
  font-weight: 700;
  margin: 6rpx 0 12rpx;
}

/* tabs 胶囊 */
.tabs {
  white-space: nowrap;
  margin-bottom: 22rpx;
}
.tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: var(--card);
  font-size: 25rpx;
  color: var(--muted);
}
.tab.on {
  background: var(--green);
  color: #fff;
  border-color: var(--green);
  font-weight: 700;
}

/* 选择 chips */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
}
.chip {
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid var(--line);
  background: #fff;
  font-size: 24rpx;
  color: var(--muted);
  max-width: 100%;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.chip.on {
  background: var(--green);
  color: #fff;
  border-color: var(--green);
  font-weight: 700;
}
.mt10 {
  margin-top: 10rpx;
}
.mt14 {
  margin-top: 14rpx;
}
.mt18 {
  margin-top: 18rpx;
}
.mt20 {
  margin-top: 20rpx;
}

/* 文案版本卡 */
.ver {
  border: 1rpx solid var(--line);
  border-radius: 18rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
  background: #fbf8ef;
}
.ver.adopted {
  border-color: var(--green);
  background: #f1f6ee;
}
.ver-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.ver-adopted {
  font-size: 21rpx;
  color: var(--green);
  font-weight: 700;
}
.ver-text {
  font-size: 25rpx;
  line-height: 1.7;
  margin-top: 12rpx;
}
.ver-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 14rpx;
}

/* 海报文案包 */
.pk {
  border: 2rpx dashed var(--green);
  border-radius: 18rpx;
  padding: 22rpx;
  background: #f3f8f0;
}
.pk-title {
  font-size: 32rpx;
  font-weight: 900;
}
.pk-sub {
  font-size: 24rpx;
  color: var(--muted);
  margin-top: 8rpx;
}
.pk-point {
  font-size: 24rpx;
  margin-top: 10rpx;
  line-height: 1.6;
}
.pk-cta {
  margin-top: 16rpx;
  display: inline-block;
  background: var(--orange);
  color: #fff;
  border-radius: 999rpx;
  padding: 8rpx 22rpx;
  font-size: 23rpx;
  font-weight: 700;
}
.pk-alt {
  font-size: 23rpx;
  color: var(--muted);
  padding: 10rpx 0;
  border-bottom: 1rpx dashed var(--line);
}
.pk-alt:last-of-type {
  border-bottom: none;
}
.acts {
  display: flex;
  gap: 16rpx;
  margin-top: 20rpx;
}
.acts .cta {
  flex: 1;
}
